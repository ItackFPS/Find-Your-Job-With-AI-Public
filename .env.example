# Environment variables for Find Your Job With AI
# Copy this file to .env and fill in the values you need.
# Most variables are optional — the pipeline runs with sensible defaults.
# Every value here is a placeholder: never commit a filled-in .env.

# ── Legacy (not read by any code) ─────────────────────────────────────────────
# The database is always data/jobs.db and logging is configured in
# src/logging_config.py. Kept so older .env files stay recognisable.
# DATABASE_URL=file:///data/jobs.db
# LOG_LEVEL=INFO

# ── App / launcher (optional) ─────────────────────────────────────────────────
# Backend port used by FindYourJob.cmd (default 8000).
# FYJ_PORT=8000
# 1 = the API serves only processes of the Windows account running it (refuses
# other local accounts, e.g. an isolated lab agent). The Vite dev server cannot
# be used in this mode. See SECURITY.md.
# API_SAME_USER_ONLY=1
# 1 = never contact the Hugging Face Hub (set it once the embedding model has
# been downloaded by a first pipeline run).
# HF_HUB_OFFLINE=1

# ── France Travail API (OAuth2 client-credentials) ────────────────────────────
# Required only when the france_travail source is enabled in config/sources.yaml.
# Register at https://developer.francetravail.fr to obtain credentials.
# Required OAuth2 scope: o2dsoffre api_offresdemploiv2
FRANCE_TRAVAIL_CLIENT_ID=your-client-id-here
FRANCE_TRAVAIL_CLIENT_SECRET=your-client-secret-here

# ── Indeed (unofficial mobile API) ────────────────────────────────────────────
# Required only for the indeed source. It is the API key of Indeed's iOS app —
# Indeed's credential, so it is not shipped in this repository; python-jobspy
# (MIT) ships a working value in jobspy/indeed/constant.py. Without it the Indeed
# collector makes no request and reports one error; other sources are unaffected.
# Indeed's terms prohibit automated access: personal, local use only.
INDEED_API_KEY=

# ── Phase 2 — Local AI (optional, disabled by default) ───────────────────────
# Requires a local LLM server (LM Studio, Ollama) with an OpenAI-compatible API.
# Both the local AI enrichment stage and the LLM eligibility gate are turned on
# by a RUNTIME flag, not an env var: pass --ai on the CLI, or "use_ai": true in
# the API's pipeline-run request (the eligibility gate additionally needs
# profile.matching.llm_eligibility_enabled: true in config/profile.yaml).
# AI_ENABLED / AI_MODEL below are legacy names kept for backward-compatible
# .env files but are NOT read by any code — the real configuration is these
# PHASE2_*-prefixed variables (src/ai/config.py), all optional:
#   PHASE2_LLM_PROVIDER=lmstudio            # or "ollama"
#   PHASE2_LLM_ENDPOINT=http://localhost:1234
#   PHASE2_LLM_MODEL_NAME=local-model
#   PHASE2_MAX_CANDIDATES=100               # only the top-N ranked jobs are analyzed
AI_ENABLED=false
AI_MODEL=local/your-model-here

# ── Discord notifications (optional) ─────────────────────────────────────────
# Static channels — see config/notifications.yaml's discord.channels. Created
# automatically (see the reconciliation section below) — you should not need
# to set these by hand.
DISCORD_PIPELINE_WEBHOOK_URL=
DISCORD_ERRORS_WEBHOOK_URL=
DISCORD_STATISTICS_WEBHOOK_URL=
DISCORD_SYSTEM_STATUS_WEBHOOK_URL=
# Legacy single-webhook fallback used only if the per-channel vars above are
# absent — see src/notifications/config.py.
DISCORD_WEBHOOK_URL=
# Per-location channels are created automatically (see below) — each gets its
# own DISCORD_LOCATION_<SLUG>_WEBHOOK_URL / DISCORD_TOP10_<SLUG>_WEBHOOK_URL
# var, e.g. DISCORD_LOCATION_DEPT_83_WEBHOOK_URL. You should not need to set
# these by hand.

# ── Discord infrastructure administration (optional) ─────────────────────────
# Enables automatic reconciliation of Discord location/top10/static
# channels+webhooks (job-83, top10-83, pipeline, errors, statistics,
# system-status, ...) from your Profile's location_preferences plus
# discord.permanent_channels (src/notifications/discord_reconciler_worker.py).
# Runs entirely in the backend — no Claude Code/MCP session required. Leave
# unset to disable: the backend runs fine without it, simply skipping every
# reconciliation tick.
# Bot permissions needed: View Channel, Manage Channels, Manage Webhooks
# (NOT Administrator).
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# How often to check the profile for location changes and reconcile Discord
# infrastructure (seconds). Default 300 (5 minutes); floor is 30.
DISCORD_RECONCILER_INTERVAL_SECONDS=300

# ── System status heartbeat (optional) ────────────────────────────────────────
# Refreshes ONE standing message in the #system-status channel (see
# config/notifications.yaml's discord.channels.system-status) with backend/
# database/pipeline/n8n/Discord-config health — independent of pipeline runs.
# Runs entirely in the backend (src/notifications/system_status_worker.py),
# separate from the Discord reconciler above. Default 300 (5 minutes); floor
# is 30. No-ops harmlessly if the system-status channel isn't enabled/configured.
SYSTEM_STATUS_INTERVAL_SECONDS=300

# ── n8n (optional) ────────────────────────────────────────────────────────────
# See config/notifications.yaml's n8n section and its migration notes.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/job-pipeline
# Opt-in shared secret protecting the n8n-facing endpoints ONLY
# (GET /api/jobs/digest/weekly, /digest/weekly-combined,
# /api/pipeline/runs/{run_id}/jobs/n8n — see src/api/auth.py). Leave unset
# to keep those endpoints open, exactly as before (the current local-first
# default — nothing else in the API requires this). If set, the n8n
# workflow (config/n8n_weekly_digest.json) must send the SAME value in an
# X-N8N-API-Key header, via an n8n instance variable named N8N_CALLER_API_KEY
# — never hardcode it into the workflow JSON.
# NOT the same variable as N8N_API_KEY — some local .env files (including
# this project's, at the time this was added) separately define
# N8N_HOST/N8N_PORT/N8N_PROTOCOL/N8N_API_KEY for n8n's OWN server/public
# API (a credential for calling n8n's API, the opposite direction from this
# one). Reusing that name here would silently "enable" this feature using
# an unrelated value already sitting in .env — confirmed to actually happen
# during implementation. Keep these two variables separate.
N8N_CALLER_API_KEY=

# Extra Host names the backend answers to, comma-separated (issue #59). By
# default only localhost, 127.0.0.1 and [::1] are served, which blocks
# DNS-rebinding attacks from web pages. Add a name only for a client that
# reaches this backend under it — e.g. host.docker.internal for an n8n
# running in Docker. Never add a public domain.
API_ALLOWED_HOSTS=
